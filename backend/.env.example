# Copy this file to .env and fill in your real credentials

# ---------- AI Provider ----------
# Choose ONE: claude | gemini | openrouter
AI_PROVIDER=claude
# Optional: override the default model for your chosen provider
# AI_MODEL=

# Only the key for your chosen provider is needed:
ANTHROPIC_API_KEY=          # console.anthropic.com
GEMINI_API_KEY=             # aistudio.google.com/apikey
OPENROUTER_API_KEY=         # openrouter.ai/keys

# ---------- WhatsApp ----------
# From Meta Business Suite -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=choose-any-secret-string-yourself

# ---------- Email ----------
# Any SMTP provider (Gmail needs an App Password, not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Security ----------
# Set a long random string in production — never commit the real value
JWT_SECRET=

# ---------- Smart Triage (WhatsApp AI auto-reply) ----------
# Off by default — set to true only once your Knowledge Base has real
# articles. Uses whichever AI_PROVIDER is configured above.
AUTO_TRIAGE_ENABLED=false

# ---------- Payment Gateways ----------
# Configure only the ones you actually use.
RAZORPAY_KEY_ID=              # dashboard.razorpay.com (India)
RAZORPAY_KEY_SECRET=
ESEWA_MERCHANT_CODE=          # esewa.com.np merchant portal (Nepal)
ESEWA_SECRET_KEY=
KHALTI_LIVE_SECRET_KEY=       # khalti.com merchant portal (Nepal)
